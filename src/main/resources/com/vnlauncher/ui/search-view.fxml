<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Buscar (docs/diseño/capturas/buscar_*.png):
       · título, campo de búsqueda con su botón y una nota sobre el coste en peticiones
       · a la izquierda, los resultados como tarjetas (las crea SearchController)
       · a la derecha, la vista previa del resultado elegido y qué se descarga al añadirlo -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vnlauncher.ui.SearchController"
      spacing="24" styleClass="page-content">

    <Label text="Buscar" styleClass="page-title"/>

    <VBox spacing="8">
        <Label text="Título de la novela" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <!-- onAction en un TextField se dispara al pulsar Enter -->
            <TextField fx:id="queryField" promptText="p. ej. Clannad, Fate/stay night..."
                       onAction="#onSearch" HBox.hgrow="ALWAYS" maxWidth="600"/>
            <Button fx:id="searchButton" text="Buscar" onAction="#onSearch" defaultButton="true"
                    minHeight="46"/>
            <ProgressIndicator fx:id="progress" prefWidth="26" prefHeight="26"/>
        </HBox>
        <!-- Antes de la primera búsqueda: qué hacer. Mismo ancho que el campo de texto. -->
        <VBox fx:id="hintCard" styleClass="card, hint-card" maxWidth="600">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
            <Label text="Escribe un título y pulsa Enter. Aquí verás los resultados y los detalles del que elijas."
                   styleClass="muted" wrapText="true"/>
        </VBox>
    </VBox>

    <!-- Avisos (sin conexión, límite de VNDB): los pone SearchController cuando hacen falta -->
    <VBox fx:id="noticeBox" maxWidth="760"/>

    <!-- Estado vacío "No hay resultados para..." (oculto mientras haya resultados) -->
    <VBox fx:id="emptyBox" alignment="TOP_CENTER" maxWidth="760"/>

    <!-- VBox.vgrow=ALWAYS: esta fila ocupa todo el alto sobrante de la ventana -->
    <HBox fx:id="resultsRow" spacing="24" VBox.vgrow="ALWAYS">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <Label fx:id="statusLabel" styleClass="meta"/>
            <ScrollPane fitToWidth="true" styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="resultsBox" spacing="12"/>
            </ScrollPane>
        </VBox>

        <!-- Vista previa: alto según su contenido (no se estira hasta abajo). El ancho lo pone
             SearchController: el 42 % de la fila, entre 300 y 440 px. -->
        <VBox fx:id="previewCard" styleClass="card, preview-card" spacing="16"
              minWidth="300" maxWidth="440" maxHeight="-Infinity"/>
    </HBox>
</VBox>
