<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Vista de búsqueda: barra de búsqueda arriba; debajo, lista de resultados (izquierda)
     y detalle del seleccionado (derecha) separados por un SplitPane redimensionable. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vnlauncher.ui.SearchController"
      spacing="12" styleClass="content">

    <Label text="Buscar en VNDB" styleClass="section-title"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <!-- onAction en un TextField se dispara al pulsar Enter -->
        <TextField fx:id="queryField" promptText="Título de la novela visual..."
                   onAction="#onSearch" HBox.hgrow="ALWAYS"/>
        <Button fx:id="searchButton" text="Buscar" onAction="#onSearch" defaultButton="true"/>
        <ProgressIndicator fx:id="progress" prefWidth="24" prefHeight="24"/>
    </HBox>

    <Label fx:id="statusLabel" styleClass="muted"/>

    <!-- VBox.vgrow=ALWAYS: el SplitPane se estira para ocupar todo el alto sobrante -->
    <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
        <ListView fx:id="resultsList"/>

        <ScrollPane fitToWidth="true" styleClass="detail-scroll">
            <VBox fx:id="detailPane" spacing="8" styleClass="detail-pane">
                <Label fx:id="titleLabel" styleClass="detail-title" wrapText="true"/>
                <Label fx:id="altTitleLabel" styleClass="muted" wrapText="true"/>
                <Label fx:id="metaLabel" styleClass="muted" wrapText="true"/>
                <Button fx:id="addButton" text="Añadir a la biblioteca" onAction="#onAddToLibrary"/>
                <Label fx:id="descriptionLabel" wrapText="true" styleClass="description"/>
            </VBox>
        </ScrollPane>
    </SplitPane>
</VBox>
