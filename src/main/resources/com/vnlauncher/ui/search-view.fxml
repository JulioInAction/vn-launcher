<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Buscar (docs/diseño/capturas/buscar-oscuro.png y buscar-claro.png):
       · título y campo de búsqueda con su botón
       · «N resultados» encima de la lista y del panel
       · a la izquierda, los resultados como tarjetas (las crea SearchController)
       · a la derecha, un panel fijo de 540 px con los detalles del resultado elegido -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vnlauncher.ui.SearchController"
      spacing="24" styleClass="page-content">

    <Label text="Buscar" styleClass="page-title"/>

    <VBox spacing="8">
        <Label text="Título de la novela" styleClass="field-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <!-- onAction en un TextField se dispara al pulsar Enter -->
            <TextField fx:id="queryField" promptText="p. ej. Clannad, Fate/stay night..."
                       onAction="#onSearch" HBox.hgrow="ALWAYS" maxWidth="600"/>
            <Button fx:id="searchButton" text="Buscar" onAction="#onSearch" defaultButton="true"
                    minHeight="46"/>
            <ProgressIndicator fx:id="progress" prefWidth="26" prefHeight="26"/>
        </HBox>
        <!-- Antes de la primera búsqueda: qué hacer. Mismo ancho que el campo de texto. -->
        <VBox fx:id="hintCard" styleClass="card, hint-card" maxWidth="600">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
            <Label text="Escribe un título y pulsa Enter. Aquí verás los resultados y los detalles del que elijas."
                   styleClass="muted" wrapText="true"/>
        </VBox>
    </VBox>

    <!-- Avisos (sin conexión, límite de VNDB): los pone SearchController cuando hacen falta -->
    <VBox fx:id="noticeBox" maxWidth="760"/>

    <!-- Estado vacío "No hay resultados para..." (oculto mientras haya resultados) -->
    <VBox fx:id="emptyBox" alignment="TOP_CENTER" maxWidth="760"/>

    <!-- «N resultados» y debajo la fila con la lista y el panel. El contador va FUERA de la fila:
         así la primera tarjeta y el panel empiezan a la misma altura.
         VBox.vgrow=ALWAYS: ocupa todo el alto sobrante de la ventana. -->
    <VBox fx:id="resultsArea" spacing="12" VBox.vgrow="ALWAYS">
        <Label fx:id="statusLabel" styleClass="meta"/>

        <HBox spacing="24" VBox.vgrow="ALWAYS">
            <!-- La lista hace scroll por su cuenta; el panel de la derecha no se mueve con ella -->
            <ScrollPane fitToWidth="true" styleClass="plain-scroll" HBox.hgrow="ALWAYS">
                <VBox fx:id="resultsBox" spacing="12"/>
            </ScrollPane>

            <!-- Panel de 540 px fijos (min = pref = max). Alto: el de su contenido (maxHeight
                 -Infinity = USE_PREF_SIZE), sin pasar del de la ventana. Si no cabe, hace scroll por
                 dentro y el botón de abajo sigue a la vista. -->
            <VBox fx:id="previewCard" styleClass="card, preview-card"
                  minWidth="540" prefWidth="540" maxWidth="540" maxHeight="-Infinity">
                <ScrollPane fx:id="previewScroll" fitToWidth="true" hbarPolicy="NEVER"
                            styleClass="plain-scroll" VBox.vgrow="ALWAYS">
                    <!-- Sin margen derecho: lo pone el ancho fijo de cada bloque (ver
                         SearchController.INNER_WIDTH), y así la barra de scroll cabe sin
                         estrechar nada -->
                    <VBox fx:id="previewContent" spacing="24" styleClass="preview-content"/>
                </ScrollPane>
                <VBox fx:id="previewFooter" styleClass="preview-footer" minHeight="-Infinity"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
