<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!-- Biblioteca (docs/design/mockups/library-*.png):
       · cabecera: título, número de novelas y "Añadir VN"
       · franja "Continuar" con la última VN jugada (la rellena LibraryController)
       · filtros activos (estado, etiqueta) con su ✕ y "Ordenar por"
       · cuadrícula de portadas (TilePane: filas que saltan de línea cuando no caben) -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.LibraryController"
            fitToWidth="true" styleClass="plain-scroll">

    <VBox spacing="28" styleClass="page-content">
        <VBox spacing="14">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Biblioteca" styleClass="page-title"/>
                <Label fx:id="countLabel" styleClass="meta"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- "Descargando portadas · 3 de 8": solo mientras se descargan -->
                <Label fx:id="coversLabel" styleClass="meta"/>
                <!-- El ojo: muestra u oculta las imágenes sensibles mientras dure la sesión (no cambia el ajuste) -->
                <ToggleButton fx:id="revealToggle" styleClass="eye-button"/>
                <Region minWidth="12"/>
                <Button fx:id="addButton" text="+  Añadir VN" onAction="#onAddVn"/>
            </HBox>
            <ProgressBar fx:id="coversBar" progress="0" maxWidth="Infinity" styleClass="thin-bar"/>
        </VBox>

        <!-- Biblioteca vacía: "Tu biblioteca está vacía" + "Buscar en VNDB" -->
        <VBox fx:id="emptyBox" alignment="CENTER"/>

        <HBox fx:id="continueCard" styleClass="card, continue-card" spacing="20" alignment="CENTER_LEFT"/>

        <!-- Filtros activos (el estado de la barra lateral, la etiqueta de una ficha; se combinan),
             cada uno con su ✕, y a la derecha el orden. Debajo, un aviso si hace falta. -->
        <VBox spacing="10">
            <HBox fx:id="filtersRow" spacing="8" alignment="CENTER_LEFT">
                <!-- Título, título original y desarrollador. Ctrl+F lo enfoca; Esc lo vacía -->
                <TextField fx:id="searchField" promptText="Buscar en tu biblioteca" prefWidth="280"
                           minWidth="-Infinity"/>
                <!-- FlowPane: si los chips no caben en una línea (ventana estrecha), pasan a la de
                     abajo en vez de empujar y cortar el desplegable de orden -->
                <FlowPane fx:id="activeFiltersBox" hgap="8" vgap="8" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"/>
                <!-- minWidth="-Infinity" = Region.USE_PREF_SIZE: no encoger por debajo de su texto -->
                <Label text="Ordenar por" styleClass="meta" minWidth="-Infinity"/>
                <ComboBox fx:id="sortBox" prefWidth="200" minWidth="-Infinity"/>
            </HBox>
            <Label fx:id="filterNote" styleClass="meta" wrapText="true"/>
        </VBox>

        <Label fx:id="emptyLabel" styleClass="muted" wrapText="true"/>

        <TilePane fx:id="grid" hgap="22" vgap="28"/>
    </VBox>
</ScrollPane>
