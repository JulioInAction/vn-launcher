<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Ventana principal: menú lateral a la izquierda y la vista actual en el centro
     (la pone MainController).
     fx:controller dice QUÉ clase controla esta vista; CÓMO se crea lo decide Views.load
     (para pasarle el AppContext por constructor).
     Los iconos son SVGPath: un trazado vectorial (el mismo formato que el atributo "d" de SVG)
     dibujado en un cuadro de 24x24. Así no hacen falta ficheros de imagen. -->
<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.MainController">

    <left>
        <VBox styleClass="sidebar" spacing="4">
            <Label text="VN Launcher" styleClass="app-title">
                <graphic>
                    <!-- Libro -->
                    <SVGPath styleClass="app-logo"
                             content="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z M8 20a3 3 0 0 1 0-6h10"/>
                </graphic>
            </Label>

            <Button fx:id="libraryButton" text="Biblioteca" maxWidth="Infinity"
                    onAction="#showLibrary" styleClass="nav-button">
                <graphic>
                    <!-- Cuatro cuadrados -->
                    <SVGPath styleClass="nav-icon"
                             content="M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z"/>
                </graphic>
            </Button>
            <Button fx:id="searchButton" text="Buscar en VNDB" maxWidth="Infinity"
                    onAction="#showSearch" styleClass="nav-button">
                <graphic>
                    <!-- Lupa: círculo + mango -->
                    <SVGPath styleClass="nav-icon"
                             content="M11 4a7 7 0 1 0 0.01 0z M16 16l5 5"/>
                </graphic>
            </Button>

            <!-- Hueco que crece: empuja el contador hasta abajo del todo -->
            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="vndb-counter">
                <Label text="Peticiones a VNDB" styleClass="muted, small"/>
                <Label fx:id="vndbCountLabel" text="0 de 200" styleClass="vndb-counter-value"/>
                <ProgressBar fx:id="vndbCountBar" progress="0" maxWidth="Infinity" prefHeight="6"/>
                <Label text="en los últimos 5 minutos" styleClass="muted, small"/>
            </VBox>
        </VBox>
    </left>
</BorderPane>
