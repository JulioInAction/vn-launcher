<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>

<!-- Ventana principal: un BorderPane con la barra lateral a la izquierda (sidebar.fxml) y la
     pantalla actual en el centro. Las dos las pone MainController en código.
     fx:controller dice QUÉ clase controla esta vista; CÓMO se crea lo decide Views.load
     (para pasarle el AppContext por constructor). -->
<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.MainController"/>
