<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Barra lateral común a todas las pantallas (docs/DISEÑO.md, "Barra lateral").
     StackPane: abajo la marca de agua japonesa, encima el contenido.
     Las entradas de navegación, estanterías y recientes las crea SidebarController en código. -->
<StackPane fx:id="sidebarRoot"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.vnlauncher.ui.SidebarController"
           styleClass="sidebar">

    <!-- 1. Marca de agua: ビジュアルノベル ("novela visual") en vertical, puramente decorativa.
         Es una imagen (docs/diseño/marca-agua/); SidebarController elige la del tema actual.
         · Primer hijo del StackPane = se dibuja la primera, DETRÁS del resto.
         · fitHeight 496 + preserveRatio: 58 × 496 (los PNG son de 116 × 993, el doble).
         · mouseTransparent: los clics la atraviesan y llegan a los botones de encima.
         · managed="false": no ocupa sitio en el layout; el StackPane no la coloca, así que
           layoutY la baja 96 px y SidebarController la pega al borde derecho con layoutX. -->
    <ImageView fx:id="watermark" fitHeight="496" preserveRatio="true" smooth="true"
               opacity="0.07" mouseTransparent="true" managed="false" layoutY="96"/>

    <VBox styleClass="sidebar-content" spacing="0">
        <!-- 2. Logo: icono vectorial (4 formas de vn-launcher-icono.svg, caja de 64x64 a escala 0.5) -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-block">
            <!-- Group dentro de Group: el exterior mide al interior YA escalado; si no, el HBox
                 reservaría los 64 px originales aunque se vea a 32 -->
            <Group>
            <Group scaleX="0.5" scaleY="0.5">
                <!-- Libro delantero (rectángulo redondeado), lomo, libro trasero y marcapáginas -->
                <SVGPath styleClass="logo-stroke" strokeWidth="4"
                         content="M13 6H33A5 5 0 0 1 38 11V43A5 5 0 0 1 33 48H13A5 5 0 0 1 8 43V11A5 5 0 0 1 13 6Z"/>
                <SVGPath styleClass="logo-stroke" strokeWidth="3" content="M15 8V46"/>
                <SVGPath styleClass="logo-stroke" strokeWidth="4"
                         content="M43 14H50A5 5 0 0 1 55 19V53A5 5 0 0 1 50 58H26A5 5 0 0 1 21 53V52.5"/>
                <SVGPath styleClass="logo-fill" content="M24 4V21L28 17.5L32 21V4Z"/>
            </Group>
            </Group>
            <Label text="VN Launcher" styleClass="logo-text"/>
        </HBox>

        <Region minHeight="28"/>

        <!-- 3. Navegación numerada -->
        <VBox fx:id="navBox" spacing="2"/>

        <Region minHeight="26"/>

        <!-- 4. Estanterías -->
        <Label text="ESTANTERÍAS" styleClass="caps, sidebar-block">
            <VBox.margin><Insets bottom="4"/></VBox.margin>
        </Label>
        <VBox fx:id="shelvesBox" spacing="0"/>

        <Region minHeight="22"/>

        <!-- 5. Recientes -->
        <Label text="RECIENTES" styleClass="caps, sidebar-block">
            <VBox.margin><Insets bottom="10"/></VBox.margin>
        </Label>
        <HBox fx:id="recentBox" spacing="10" styleClass="sidebar-block"/>

        <!-- Hueco que crece: empuja lo siguiente hasta abajo del todo -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- 6. Contador de peticiones a VNDB (el tema se cambia en Ajustes → Apariencia) -->
        <VBox spacing="8" styleClass="sidebar-block">
            <HBox alignment="CENTER_LEFT">
                <Label text="VNDB · últimos 5 min" styleClass="muted, small"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="vndbCountLabel" text="0/200" styleClass="counter-value"/>
            </HBox>
            <ProgressBar fx:id="vndbCountBar" progress="0" maxWidth="Infinity" styleClass="thin-bar"/>
        </VBox>
    </VBox>
</StackPane>
