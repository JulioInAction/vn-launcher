<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ficha de una VN (ficha-simplificada-*.png):
       · cabecera: portada + título, chips de estado y estanterías, acciones (Jugar, Opciones del
         juego, ⋯), datos en una línea, etiquetas y descripción, y la galería de capturas (a la
         derecha o debajo, según el ancho)
       · sección Rutas (la crea VnDetailController: RoutesPane)
       · sección Personajes principales
     Todo dentro de un ScrollPane porque puede ser largo. -->
<ScrollPane fx:id="scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.VnDetailController"
            fitToWidth="true" styleClass="plain-scroll">

    <VBox fx:id="pageContent" spacing="28" styleClass="page-content">
        <Button fx:id="backButton" text="‹  Biblioteca" onAction="#onBack" styleClass="link-button"/>

        <!-- Avisos de "Actualizar desde VNDB" (sin conexión...). Solo ocupa sitio si hay alguno. -->
        <VBox fx:id="noticeBox" maxWidth="760"/>

        <!-- ================================================= cabecera
             Con la ventana ancha, tres columnas: portada, información y galería de capturas (la
             pone VnDetailController). Si no caben, la galería pasa debajo de esta fila. -->
        <HBox fx:id="headerRow" spacing="28">
            <!-- Aquí VnDetailController pone un CoverView cuando carga la VN.
                 alignment TOP_CENTER: el HBox estira este hueco a toda la altura de la fila
                 y sin esto la portada saldría centrada en vertical. -->
            <!-- 330 de portada + 50 reservados debajo para el control «Cambiar portada» -->
            <StackPane fx:id="coverBox" alignment="TOP_CENTER" minWidth="220" minHeight="380"/>

            <!-- Columna central (ficha-simplificada-*.png), de arriba abajo -->
            <VBox fx:id="infoColumn" spacing="16" HBox.hgrow="ALWAYS" minWidth="400">
                <!-- 1. Título, título original y «Desarrollador · año» -->
                <VBox spacing="4">
                    <Label fx:id="titleLabel" styleClass="detail-title" wrapText="true"/>
                    <Label fx:id="altTitleLabel" styleClass="muted, original-text" wrapText="true"/>
                    <!-- «Desarrollador · año» y, en la vista previa, si el juego está terminado -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="metaLabel" styleClass="text2"/>
                        <Label fx:id="devStatusPill" styleClass="pill, pill-devstatus"/>
                    </HBox>
                </VBox>

                <!-- 2. Chips sin rótulos: el estado (StatusPicker) y las estanterías con ✕ y un «+»
                        redondo (ShelfChips). Los pone VnDetailController. -->
                <FlowPane fx:id="chipsRow" hgap="8" vgap="8" alignment="CENTER_LEFT"/>

                <!-- Aviso «No se encuentra el ejecutable» (fase 7). Solo ocupa sitio si lo hay -->
                <VBox fx:id="exeNoticeBox"/>

                <!-- 3. Acciones: «Jugar», «Opciones del juego» (engranaje) y «Más opciones» (⋯). A la
                        derecha, lo que pasa al actualizar desde VNDB: no mueve nada al aparecer -->
                <HBox fx:id="actionsRow" spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="playButton" text="▶  Jugar" onAction="#onPlay"
                            styleClass="primary-button, big-button" minWidth="-Infinity"/>
                    <!-- Solo en la vista previa (ficha-vista-previa-*.png): «Añadir a la biblioteca» -->
                    <Button fx:id="addButton" text="Añadir a la biblioteca" onAction="#onAdd"
                            styleClass="primary-button, big-button" minWidth="-Infinity"/>
                    <Button fx:id="optionsButton" onAction="#onOptions" styleClass="square-button"/>
                    <Button fx:id="moreButton" onAction="#onMore" styleClass="square-button"/>
                    <HBox fx:id="refreshBox" spacing="8" alignment="CENTER_LEFT">
                        <HBox.margin><Insets left="6"/></HBox.margin>
                        <ProgressIndicator fx:id="refreshSpinner" styleClass="small-spinner"/>
                        <Label fx:id="refreshStatus" styleClass="action-status"/>
                    </HBox>
                </HBox>

                <!-- Solo en la vista previa: «No está en tu biblioteca» -->
                <Label fx:id="notInLibraryNote" text="No está en tu biblioteca" styleClass="not-in-library"/>

                <!-- Solo en la vista previa, en el sitio de la línea de datos: tarjetas de Duración,
                        Valoración e Idiomas (DetailLayout) -->
                <FlowPane fx:id="factCardsRow" hgap="12" vgap="12"/>

                <!-- 4. «37 min jugados · última partida hace 3 h · 0 de 4 rutas» + barra de las rutas.
                        FlowPane: si no cabe, salta de línea entre una parte y otra, nunca a mitad -->
                <FlowPane fx:id="statsRow" vgap="4" rowValignment="CENTER"/>

                <!-- 5. Etiquetas en una línea + «+N más» (TagChips, en código). Se oculta si no hay -->
                <VBox fx:id="tagsContainer"/>

                <!-- 6. Descripción, 3 líneas hasta pulsar «Leer más» -->
                <VBox spacing="4">
                    <Label fx:id="descriptionLabel" wrapText="true" styleClass="description"/>
                    <Hyperlink fx:id="readMoreLink" text="Leer más" onAction="#onToggleDescription"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- ================================================= rutas (RoutesPane, en código) -->
        <VBox fx:id="routesContainer"/>

        <!-- ================================================= personajes -->
        <VBox spacing="12">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Personajes principales" styleClass="section-title"/>
                    <Label fx:id="charactersSubtitle" text="Rol «primary» en VNDB. Marca cuáles tienen ruta."
                           styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="showSpoilersCheck" text="Mostrar spoilers"/>
                <CheckBox fx:id="showSensitiveCheck" text="Mostrar imágenes sensibles"/>
            </HBox>
            <Label fx:id="charactersStatus" styleClass="muted" wrapText="true"/>
            <!-- FlowPane: coloca las tarjetas en fila y salta de línea cuando no caben -->
            <FlowPane fx:id="charactersPane" hgap="14" vgap="14"/>
        </VBox>

    </VBox>
</ScrollPane>
