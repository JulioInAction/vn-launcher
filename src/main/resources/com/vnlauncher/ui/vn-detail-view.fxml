<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ficha de una VN (según el prototipo):
       · cabecera: portada + título, acciones (Jugar, ejecutable, Locale Emulator), datos, etiquetas
         y descripción, y la galería de capturas (a la derecha o debajo, según el ancho)
       · sección Rutas (la crea VnDetailController: RoutesPane)
       · sección Personajes principales
     Todo dentro de un ScrollPane porque puede ser largo. -->
<ScrollPane fx:id="scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.VnDetailController"
            fitToWidth="true" styleClass="plain-scroll">

    <VBox fx:id="pageContent" spacing="28" styleClass="page-content">
        <Button text="‹  Biblioteca" onAction="#onBack" styleClass="link-button"/>

        <!-- Avisos de "Actualizar desde VNDB" (sin conexión...). Solo ocupa sitio si hay alguno. -->
        <VBox fx:id="noticeBox" maxWidth="760"/>

        <!-- ================================================= cabecera
             Con la ventana ancha, tres columnas: portada, información y galería de capturas (la
             pone VnDetailController). Si no caben, la galería pasa debajo de esta fila. -->
        <HBox fx:id="headerRow" spacing="28">
            <!-- Aquí VnDetailController pone un CoverView cuando carga la VN.
                 alignment TOP_CENTER: el HBox estira este hueco a toda la altura de la fila
                 y sin esto la portada saldría centrada en vertical. -->
            <!-- 330 de portada + 50 reservados debajo para el control «Cambiar portada» -->
            <StackPane fx:id="coverBox" alignment="TOP_CENTER" minWidth="220" minHeight="380"/>

            <VBox fx:id="infoColumn" spacing="12" HBox.hgrow="ALWAYS" minWidth="400">
                <VBox spacing="4">
                    <Label fx:id="titleLabel" styleClass="detail-title" wrapText="true"/>
                    <Label fx:id="altTitleLabel" styleClass="muted, original-text" wrapText="true"/>
                    <!-- FlowPane en vez de HBox (aquí y más abajo): con la galería a la derecha esta
                         columna puede quedarse en 400 px, y entonces salta de línea en vez de cortarse -->
                    <FlowPane hgap="6" vgap="2" rowValignment="BASELINE">
                        <Label fx:id="metaLabel" styleClass="muted"/>
                        <Label text="·" styleClass="muted"/>
                        <Hyperlink text="Ver en VNDB" onAction="#onOpenVndb"/>
                        <Label text="·" styleClass="muted"/>
                        <!-- Vuelve a pedir la ficha, los personajes y las etiquetas y capturas (3 peticiones) -->
                        <Hyperlink fx:id="refreshLink" text="Actualizar desde VNDB" onAction="#onRefresh"/>
                        <Label fx:id="refreshStatus" styleClass="muted"/>
                    </FlowPane>
                </VBox>

                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                    <Button fx:id="playButton" text="▶  Jugar" onAction="#onPlay"
                            styleClass="primary-button, big-button"/>
                    <Button fx:id="exeButton" text="Elegir ejecutable" onAction="#onChooseExecutable"
                            styleClass="secondary-button"/>
                    <!-- Solo se ve cuando hay programa de configuración (config.exe...) -->
                    <Button fx:id="configButton" text="Configuración" onAction="#onOpenConfig"
                            styleClass="secondary-button"/>
                </FlowPane>
                <VBox spacing="2">
                    <Label fx:id="exePathLabel" styleClass="exe-path"/>
                    <!-- "Configuración: C:\...\config.exe · Cambiar · Quitar", o el enlace para añadirlo -->
                    <HBox fx:id="configRow" spacing="6" alignment="BASELINE_LEFT">
                        <Label fx:id="configPathLabel" styleClass="exe-path"/>
                        <Hyperlink fx:id="configChangeLink" onAction="#onChooseConfig" styleClass="small-link"/>
                        <Hyperlink fx:id="configRemoveLink" text="Quitar" onAction="#onRemoveConfig"
                                   styleClass="small-link"/>
                    </HBox>
                </VBox>
                <CheckBox fx:id="localeEmulatorCheck" text="Lanzar con Locale Emulator (perfil japonés)"
                          wrapText="true"/>

                <!-- «Estanterías» (ShelfChips) y «Estado» (StatusPicker), en código; ficha-estado-*.png.
                     Las etiquetas tienen el mismo ancho fijo para que los controles queden en columna. -->
                <HBox fx:id="shelvesRow" spacing="0" alignment="CENTER_LEFT">
                    <Label text="Estanterías" styleClass="text2" minWidth="126" prefWidth="126"/>
                </HBox>
                <HBox fx:id="statusRow" spacing="0" alignment="CENTER_LEFT">
                    <Label text="Estado" styleClass="text2" minWidth="126" prefWidth="126"/>
                </HBox>

                <!-- Tarjetas de datos (si no caben las tres en una fila, pasan a la siguiente) -->
                <FlowPane hgap="10" vgap="10">
                    <VBox styleClass="stat-card">
                        <Label text="Tiempo jugado" styleClass="stat-label"/>
                        <Label fx:id="playTimeLabel" text="0 min" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Última partida" styleClass="stat-label"/>
                        <Label fx:id="lastPlayedLabel" text="Nunca" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Rutas" styleClass="stat-label"/>
                        <Label fx:id="routesStatLabel" text="Sin rutas" styleClass="stat-value"/>
                        <ProgressBar fx:id="routesStatBar" progress="0" maxWidth="Infinity" prefHeight="6"/>
                    </VBox>
                </FlowPane>

                <!-- Etiquetas (TagChips, en código): debajo de las tarjetas y antes de la descripción.
                     Se oculta si la VN no tiene ninguna que enseñar. -->
                <VBox fx:id="tagsContainer">
                    <VBox.margin>
                        <Insets top="6" bottom="8"/>
                    </VBox.margin>
                </VBox>

                <Label fx:id="launchStatusLabel" styleClass="muted" wrapText="true"/>

                <VBox spacing="4">
                    <Label fx:id="descriptionLabel" wrapText="true" styleClass="description"/>
                    <Hyperlink fx:id="readMoreLink" text="Leer más" onAction="#onToggleDescription"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- ================================================= rutas (RoutesPane, en código) -->
        <VBox fx:id="routesContainer"/>

        <!-- ================================================= personajes -->
        <VBox spacing="12">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Personajes principales" styleClass="section-title"/>
                    <Label text="Rol «primary» en VNDB. Marca cuáles tienen ruta." styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="showSpoilersCheck" text="Mostrar spoilers"/>
                <CheckBox fx:id="showSensitiveCheck" text="Mostrar imágenes sensibles"/>
            </HBox>
            <Label fx:id="charactersStatus" styleClass="muted" wrapText="true"/>
            <!-- FlowPane: coloca las tarjetas en fila y salta de línea cuando no caben -->
            <FlowPane fx:id="charactersPane" hgap="14" vgap="14"/>
        </VBox>

        <HBox>
            <Button fx:id="removeButton" text="Quitar de la biblioteca"
                    onAction="#onRemove" styleClass="danger-button"/>
        </HBox>
    </VBox>
</ScrollPane>
