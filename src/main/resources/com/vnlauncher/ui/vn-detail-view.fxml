<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ficha de una VN (según el prototipo):
       · cabecera: portada + título, acciones (Jugar, ejecutable, Locale Emulator), datos y descripción
       · sección Rutas (la crea VnDetailController: RoutesPane)
       · sección Personajes principales
     Todo dentro de un ScrollPane porque puede ser largo. -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vnlauncher.ui.VnDetailController"
            fitToWidth="true" styleClass="plain-scroll">

    <VBox spacing="28" styleClass="content">
        <Button text="‹  Biblioteca" onAction="#onBack" styleClass="link-button"/>

        <!-- ================================================= cabecera -->
        <HBox spacing="28">
            <!-- Aquí VnDetailController pone un CoverView cuando carga la VN.
                 alignment TOP_CENTER: el HBox estira este hueco a toda la altura de la fila
                 y sin esto la portada saldría centrada en vertical. -->
            <StackPane fx:id="coverBox" alignment="TOP_CENTER" minWidth="220" minHeight="310"/>

            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <VBox spacing="4">
                    <Label fx:id="titleLabel" styleClass="detail-title" wrapText="true"/>
                    <Label fx:id="altTitleLabel" styleClass="muted" wrapText="true"/>
                    <HBox spacing="6" alignment="BASELINE_LEFT">
                        <Label fx:id="metaLabel" styleClass="muted"/>
                        <Label text="·" styleClass="muted"/>
                        <Hyperlink text="Ver en VNDB" onAction="#onOpenVndb"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="playButton" text="▶  Jugar" onAction="#onPlay"
                            styleClass="primary-button, big-button"/>
                    <Button fx:id="exeButton" text="Elegir ejecutable" onAction="#onChooseExecutable"
                            styleClass="secondary-button"/>
                </HBox>
                <Label fx:id="exePathLabel" styleClass="exe-path"/>
                <CheckBox fx:id="localeEmulatorCheck" text="Lanzar con Locale Emulator (perfil japonés)"/>

                <!-- Tarjetas de datos. En la Fase 6 se añadirá "Tiempo jugado". -->
                <HBox spacing="10">
                    <VBox styleClass="stat-card">
                        <Label text="Última partida" styleClass="stat-label"/>
                        <Label fx:id="lastPlayedLabel" text="Nunca" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Rutas" styleClass="stat-label"/>
                        <Label fx:id="routesStatLabel" text="Sin rutas" styleClass="stat-value"/>
                        <ProgressBar fx:id="routesStatBar" progress="0" maxWidth="Infinity" prefHeight="6"/>
                    </VBox>
                </HBox>

                <Label fx:id="launchStatusLabel" styleClass="muted" wrapText="true"/>

                <VBox spacing="4">
                    <Label fx:id="descriptionLabel" wrapText="true" styleClass="description"/>
                    <Hyperlink fx:id="readMoreLink" text="Leer más" onAction="#onToggleDescription"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- ================================================= rutas (RoutesPane, en código) -->
        <VBox fx:id="routesContainer"/>

        <!-- ================================================= personajes -->
        <VBox spacing="12">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Personajes principales" styleClass="section-title"/>
                    <Label text="Rol «primary» en VNDB. Marca cuáles tienen ruta." styleClass="muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="showSpoilersCheck" text="Mostrar spoilers"/>
                <CheckBox fx:id="showSensitiveCheck" text="Mostrar imágenes sensibles"/>
            </HBox>
            <Label fx:id="charactersStatus" styleClass="muted" wrapText="true"/>
            <!-- FlowPane: coloca las tarjetas en fila y salta de línea cuando no caben -->
            <FlowPane fx:id="charactersPane" hgap="14" vgap="14"/>
        </VBox>

        <HBox>
            <Button fx:id="removeButton" text="Quitar de la biblioteca"
                    onAction="#onRemove" styleClass="danger-button"/>
        </HBox>
    </VBox>
</ScrollPane>
