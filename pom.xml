<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vnlauncher</groupId>
    <artifactId>vn-launcher</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>VN Launcher</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versión de Java del bytecode. Se puede sobrescribir al compilar:
             mvn -Dmaven.compiler.release=25 ... (útil si solo tienes un JDK más antiguo). -->
        <maven.compiler.release>26</maven.compiler.release>

        <javafx.version>26.0.2</javafx.version>
        <sqlite.version>3.54.1.0</sqlite.version>
        <jackson.version>2.22.4</jackson.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- JavaFX: controls arrastra a javafx-graphics y javafx-base.
             El pom de OpenJFX detecta el sistema operativo y descarga los nativos correctos
             (Windows en tu PC, Linux en el mío), así que no hay que indicar "classifier". -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver JDBC de SQLite. Lleva la librería nativa de SQLite dentro del .jar,
             no hay que instalar nada en Windows. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Jackson: convierte JSON <-> objetos Java (incluidos records).
             databind arrastra a jackson-core y jackson-annotations. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <executions>
                    <!-- Solo al compilar los TESTS: permitir usar jdk.httpserver (ver surefire). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.vnlauncher=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- enable-native-access: Java 24+ avisa cuando una librería carga código
                         nativo (SQLite lo hace); le damos permiso explícito.
                         add-modules/add-reads: los tests del cliente VNDB levantan un servidor HTTP
                         falso con jdk.httpserver. Ese módulo solo lo usan los tests, así que no lo
                         ponemos en module-info.java sino aquí. -->
                    <argLine>
                        --enable-native-access=org.xerial.sqlitejdbc
                        --add-modules jdk.httpserver
                        --add-reads com.vnlauncher=jdk.httpserver
                    </argLine>
                </configuration>
            </plugin>
            <!-- Permite arrancar la app con: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Formato "módulo/clase principal" porque usamos module-info.java -->
                    <mainClass>com.vnlauncher/com.vnlauncher.app.Main</mainClass>
                    <options>
                        <!-- Permiso para cargar código nativo (ver nota en surefire). -->
                        <option>--enable-native-access=javafx.graphics,org.xerial.sqlitejdbc</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
