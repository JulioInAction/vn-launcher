<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.vnlauncher</groupId>
    <artifactId>vn-launcher</artifactId>
    <!-- Versión de la aplicación: sale en Ajustes → Acerca de y en el instalador. Solo números
         (jpackage no admite "-SNAPSHOT"). Súbela antes de generar un instalador nuevo: Windows
         solo sustituye una instalación por otra de versión MAYOR. -->
    <version>1.0.0</version>
    <name>VN Launcher</name>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Versión de Java del bytecode. Se puede sobrescribir al compilar:
             mvn -Dmaven.compiler.release=25 ... (útil si solo tienes un JDK más antiguo). -->
        <maven.compiler.release>26</maven.compiler.release>

        <javafx.version>26.0.2</javafx.version>
        <sqlite.version>3.54.1.0</sqlite.version>
        <jackson.version>2.22.4</jackson.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- JavaFX: controls arrastra a javafx-graphics y javafx-base.
             El pom de OpenJFX detecta el sistema operativo y descarga los nativos correctos
             (Windows en tu PC, Linux en el mío), así que no hay que indicar "classifier". -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver JDBC de SQLite. Lleva la librería nativa de SQLite dentro del .jar,
             no hay que instalar nada en Windows. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Jackson: convierte JSON <-> objetos Java (incluidos records).
             databind arrastra a jackson-core y jackson-annotations. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Recursos: se copian tal cual, salvo app.properties, donde Maven sustituye
             ${project.version} por la versión de arriba ("filtrado"). Así la versión se escribe en
             un único sitio. No se filtra todo: estropearía las fuentes y las imágenes. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>com/vnlauncher/app/app.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>com/vnlauncher/app/app.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <executions>
                    <!-- Solo al compilar los TESTS: permitir usar jdk.httpserver (ver surefire). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.vnlauncher=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- enable-native-access: Java 24+ avisa cuando una librería carga código
                         nativo (SQLite lo hace); le damos permiso explícito.
                         add-modules/add-reads: los tests del cliente VNDB levantan un servidor HTTP
                         falso con jdk.httpserver. Ese módulo solo lo usan los tests, así que no lo
                         ponemos en module-info.java sino aquí. -->
                    <argLine>
                        --enable-native-access=org.xerial.sqlitejdbc
                        --add-modules jdk.httpserver
                        --add-reads com.vnlauncher=jdk.httpserver
                    </argLine>
                </configuration>
            </plugin>
            <!-- Permite arrancar la app con: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Formato "módulo/clase principal" porque usamos module-info.java -->
                    <mainClass>com.vnlauncher/com.vnlauncher.app.Main</mainClass>
                    <options>
                        <!-- Permiso para cargar código nativo (ver nota en surefire). -->
                        <option>--enable-native-access=javafx.graphics,org.xerial.sqlitejdbc</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- =============================================================== instalador
             mvn clean package -P instalador
             Genera en target/instalador el instalador de Windows (o, en Linux, una carpeta con el
             ejecutable). Pasos, todos en la fase "package":
               1. el .jar de la app y sus dependencias se copian a target/jpackage/mods
               2. jlink crea un Java reducido (target/jpackage/runtime) con solo los módulos del JDK
                  que hacen falta: así no hace falta tener Java instalado para usar la app
               3. jpackage junta las dos cosas y crea el instalador
             El "clean" es necesario: jlink y jpackage no sobrescriben carpetas que ya existen. -->
        <profile>
            <id>instalador</id>
            <properties>
                <jpackage.dir>${project.build.directory}/jpackage</jpackage.dir>
                <!-- Módulos del JDK que necesitan la app y sus librerías. Se sacaron con las
                     herramientas jdeps (opción print-module-deps) y java (opción describe-module)
                     sobre cada .jar: p. ej. sqlite-jdbc pide java.sql.rowset y JavaFX java.desktop.
                     (Las opciones van sin sus dos guiones porque en XML no se pueden escribir
                     dos guiones seguidos dentro de un comentario.) -->
                <jlink.modules>java.base,java.desktop,java.logging,java.net.http,java.scripting,java.sql,java.sql.rowset,java.xml,jdk.unsupported</jlink.modules>
            </properties>
            <build>
                <plugins>
                    <!-- 1a. El .jar de la app, directamente a la carpeta de módulos -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.2</version>
                        <configuration>
                            <outputDirectory>${jpackage.dir}/mods</outputDirectory>
                        </configuration>
                    </plugin>
                    <!-- 1b. Las dependencias (JavaFX, SQLite, Jackson) a la misma carpeta.
                         De JavaFX llegan dos .jar por módulo: el del sistema (con los nativos) y uno
                         "vacío" sin clases (módulo javafx.xxxEmpty); este último no estorba. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copiar-modulos</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jpackage.dir}/mods</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- 2 y 3. jlink y jpackage son programas del JDK: se ejecutan con exec-maven-plugin -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <!-- java.home = el JDK con el que se ejecuta Maven -->
                                    <executable>${java.home}/bin/jlink${exe.suffix}</executable>
                                    <arguments>
                                        <argument>--add-modules</argument>
                                        <argument>${jlink.modules}</argument>
                                        <!-- Quitar lo que no hace falta para ejecutar: ocupa menos -->
                                        <argument>--strip-debug</argument>
                                        <argument>--no-header-files</argument>
                                        <argument>--no-man-pages</argument>
                                        <argument>--output</argument>
                                        <argument>${jpackage.dir}/runtime</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage${exe.suffix}</executable>
                                    <arguments>
                                        <argument>--name</argument>
                                        <argument>VN Launcher</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>VN Launcher</argument>
                                        <argument>--description</argument>
                                        <argument>Launcher de novelas visuales</argument>
                                        <!-- El Java reducido del paso 2 y los módulos del paso 1 -->
                                        <argument>--runtime-image</argument>
                                        <argument>${jpackage.dir}/runtime</argument>
                                        <argument>--module-path</argument>
                                        <argument>${jpackage.dir}/mods</argument>
                                        <argument>--module</argument>
                                        <argument>com.vnlauncher/com.vnlauncher.app.Main</argument>
                                        <!-- Igual que en javafx:run (ver arriba) -->
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=javafx.graphics,org.xerial.sqlitejdbc</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/instalador</argument>
                                        <!-- Opciones de cada sistema (tipo, icono, menú Inicio...):
                                             un archivo de src/packaging (ver los perfiles de abajo) -->
                                        <argument>@${jpackage.options}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Perfiles que se activan solos según el sistema operativo y solo ponen propiedades.
             jpackage.options se puede cambiar al ejecutar, p. ej. para la versión portable:
             mvn clean package -P instalador -Djpackage.options=src/packaging/windows/portable.txt -->
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <exe.suffix>.exe</exe.suffix>
                <jpackage.options>src/packaging/windows/instalador.txt</jpackage.options>
            </properties>
        </profile>
        <profile>
            <id>no-windows</id>
            <activation>
                <os>
                    <family>!windows</family>
                </os>
            </activation>
            <properties>
                <exe.suffix/>
                <jpackage.options>src/packaging/linux/portable.txt</jpackage.options>
            </properties>
        </profile>
    </profiles>
</project>
